// =============================================================
// College LMS — Prisma Schema
// Phase 1: Authentication & Account Setup
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  DISABLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RoleName {
  STUDENT
  FACULTY
  TRAINER
  HOD
  TPO
  COLLEGE_ADMIN
  SUPERINTENDENT
  SUPER_ADMIN
}

enum AuditAction {
  ACCOUNT_CREATED
  LOGIN
  LOGOUT
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  ROLE_CHANGED
  ROLE_ASSIGNED
  ROLE_REMOVED
  COLLEGE_CHANGED
  PROFILE_UPDATED
  PASSWORD_CHANGED
  SESSION_REVOKED
  AUTHORIZATION_FAILURE
  ACCOUNT_SUSPENDED
  ACCOUNT_DISABLED
  ACCOUNT_REACTIVATED
}

// ─── COLLEGE / TENANT ────────────────────────────────────────

model College {
  id        String   @id @default(uuid()) 
  name      String
  code      String   @unique             // e.g. "MIT", "SVCE"
  type      String?                      // College Type
  domain    String?                      // optional email domain for verification
  address   String?
  addressLine2 String?
  city      String?
  district  String?
  state     String?
  country   String?  @default("India")
  pincode   String?
  phone     String?
  email     String?
  website   String?
  logoUrl   String?  @map("logo_url")
  establishedYear Int?
  
  // Academic Information
  affiliatedUniversity String?
  accreditation       String?
  naacGrade           String?
  recognition         String?
  institutionType     String?
  
  // Administration
  principalName       String?
  principalEmail      String?
  principalPhone      String?
  adminOfficeEmail    String?
  adminOfficePhone    String?
  
  adminName           String? @map("admin_name")
  adminEmail          String? @map("admin_email")
  adminUid            String? @map("admin_uid")

  // Online Presence
  linkedinUrl         String?
  instagramUrl        String?
  facebookUrl         String?
  youtubeUrl          String?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  approvals     AccountApproval[]
  authedUsers   AuthedUser[]
  departments   Department[]
  academicYears AcademicYear[]

  @@map("colleges")
}

// ─── ROLE ────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid()) 
  name        RoleName @unique
  displayName String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

// ─── PERMISSION ──────────────────────────────────────────────

model Permission {
  id          String   @id @default(uuid()) 
  name        String   @unique           // e.g. "users:read", "approvals:manage"
  displayName String
  description String?
  module      String                     // e.g. "users", "approvals", "profiles"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

// ─── ROLE ↔ PERMISSION (many-to-many) ────────────────────────

model RolePermission {
  id           String   @id @default(uuid()) 
  roleId       String   
  permissionId String   
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─── USER ────────────────────────────────────────────────────

model User {
  id          String        @id @default(uuid()) 
  firebaseUid String        @unique          // from Firebase Authentication
  email       String        @unique
  phone       String?
  collegeId   String?       
  status      AccountStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  college   College?           @relation(fields: [collegeId], references: [id])
  profile   Profile?
  userRoles UserRole[]
  approvals AccountApproval[]
  sessions  Session[]
  auditLogs AuditLog[]         @relation("AuditSubject")
  auditedBy AuditLog[]         @relation("AuditActor")

  @@index([collegeId])
  @@index([firebaseUid])
  @@map("users")
}

// ─── USER ↔ ROLE (many-to-many) ──────────────────────────────

model UserRole {
  id         String   @id @default(uuid()) 
  userId     String   
  roleId     String   
  assignedAt DateTime @default(now())
  assignedBy String?            // who assigned this role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ─── PROFILE ─────────────────────────────────────────────────

model Profile {
  id                         String   @id @default(uuid()) 
  userId                     String   @unique 
  firstName                  String?
  lastName                   String?
  displayName                String?
  phone                      String?
  dateOfBirth                DateTime? @db.Date
  gender                     String?
  designation                String?
  department                 String?
  employeeId                 String?
  studentId                  String?
  enrollmentYear             Int?
  profilePhotoUrl            String?
  bio                        String?
  address                    String?
  city                       String?
  state                      String?
  linkedinUrl                String?
  profileCompletionPercentage Int     @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─── ACCOUNT APPROVAL ────────────────────────────────────────

model AccountApproval {
  id               String         @id @default(uuid()) 
  userId           String         
  requestedRole    RoleName
  requestedCollege String         
  status           ApprovalStatus @default(PENDING)
  requestedAt      DateTime       @default(now())
  reviewedBy       String?        
  reviewedAt       DateTime?
  rejectionReason  String?
  notes            String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [requestedCollege], references: [id])

  @@index([userId])
  @@index([status])
  @@index([requestedCollege])
  @@map("account_approvals")
}

// ─── SESSION / SECURITY RECORD ───────────────────────────────

model Session {
  id           String    @id @default(uuid()) 
  userId       String    
  ipAddress    String?
  userAgent    String?
  firebaseToken String?   // we only store a truncated/hashed reference, NEVER full token
  isActive     Boolean   @default(true)
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── AUDIT LOG ───────────────────────────────────────────────

model AuditLog {
  id          String      @id @default(uuid()) 
  action      AuditAction
  actorId     String?        // user who performed the action
  subjectId   String?        // user who was affected
  collegeId   String?        // tenant context
  ipAddress   String?
  userAgent   String?
  metadata    Json?                  // additional structured data
  createdAt   DateTime    @default(now())

  actor   User? @relation("AuditActor", fields: [actorId], references: [id])
  subject User? @relation("AuditSubject", fields: [subjectId], references: [id])

  @@index([actorId])
  @@index([subjectId])
  @@index([action])
  @@index([collegeId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════
// Additional tables (from Supabase — managed separately)
// ═══════════════════════════════════════════════════════════════

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AuthedUser {
  uid            String        @id
  email          String        @unique
  display_name   String?
  photo_url      String?
  provider       String?       @default("google")
  role           String?       @default("USER")
  last_login     DateTime?     @default(now()) @db.Timestamptz(6)
  created_at     DateTime?     @default(now()) @db.Timestamptz(6)
  college_id     String?
  department_id  String?       @db.Uuid
  class_id       String?       @db.Uuid
  register_number String?

  college    College?    @relation(fields: [college_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department Department? @relation("AuthedUserDepartment", fields: [department_id], references: [id], onUpdate: NoAction)
  class      Class?      @relation("AuthedUserClass", fields: [class_id], references: [id], onUpdate: NoAction)

  facultyClasses    Class[]      @relation("ClassFaculty")
  hodDepartments    Department[] @relation("DepartmentHOD")

  @@map("authed_users")
}

/// This model contains row level security and requires additional setup for migrations.
model Department {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  college_id  String
  name        String
  code        String
  hod_uid     String?
  is_active   Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)

  college      College      @relation(fields: [college_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  hod          AuthedUser?  @relation("DepartmentHOD", fields: [hod_uid], references: [uid], onUpdate: NoAction)
  authedUsers  AuthedUser[] @relation("AuthedUserDepartment")
  programs     Program[]
  subjects     Subject[]

  @@unique([college_id, code])
  @@map("departments")
}

/// This model contains row level security and requires additional setup for migrations.
model AcademicYear {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  college_id  String
  name        String
  start_date  DateTime    @db.Date
  end_date    DateTime    @db.Date
  is_current  Boolean?    @default(false)
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)

  college   College     @relation(fields: [college_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  semesters Semester[]

  @@map("academic_years")
}

/// This model contains row level security and requires additional setup for migrations.
model Program {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  department_id  String      @db.Uuid
  name           String
  type           String
  duration_years Int
  is_active      Boolean?    @default(true)
  created_at     DateTime?   @default(now()) @db.Timestamptz(6)

  department Department @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batches    Batch[]

  @@map("programs")
}

/// This model contains row level security and requires additional setup for migrations.
model Batch {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  program_id String    @db.Uuid
  start_year Int
  end_year   Int
  is_active  Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  program Program @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  classes Class[]

  @@map("batches")
}

/// This model contains row level security and requires additional setup for migrations.
model Class {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id         String    @db.Uuid
  name             String
  current_semester Int?      @default(1)
  faculty_uid      String?
  is_active        Boolean?  @default(true)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)

  batch      Batch        @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  faculty    AuthedUser?  @relation("ClassFaculty", fields: [faculty_uid], references: [uid], onUpdate: NoAction)
  students   AuthedUser[] @relation("AuthedUserClass")

  @@map("classes")
}

/// This model contains row level security and requires additional setup for migrations.
model Semester {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academic_year_id String       @db.Uuid
  term_number      Int
  start_date       DateTime     @db.Date
  end_date         DateTime     @db.Date
  created_at       DateTime?    @default(now()) @db.Timestamptz(6)

  academicYear AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("semesters")
}

/// This model contains row level security and requires additional setup for migrations.
model Subject {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  department_id   String      @db.Uuid
  name            String
  code            String
  credits         Int?        @default(3)
  semester_number Int
  is_active       Boolean?    @default(true)
  created_at      DateTime?   @default(now()) @db.Timestamptz(6)

  department Department @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("subjects")
}
